# =============================================================================
# Docker Ignore - Exclude unnecessary files from Docker build
# =============================================================================

# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.env
.env.local
*.egg-info/
.eggs/
dist/
build/

# Node.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
.npm
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation (not needed in container)
*.md
!README.md

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Render config
render.yaml

# Test files
test_*.py
tests/
pytest.ini
.coverage
htmlcov/

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Large data files that shouldn't be in image
# (uncomment if you want to exclude data)
# data/pdfs/*.pdf
# data/faiss_index/
